'use client';

import React from 'react';
import Topbar from '@/components/Topbar';
import NavRow from '@/components/NavRow';
import StatCard from '@/components/StatCard';
import RevenueChart from '@/components/RevenueChart';
import WithdrawalList from '@/components/WithdrawalList';

export default function Dashboard() {
  return (
    <>
      <div className="glow-bg"></div>
      <div style={{ position: 'relative', zIndex: 10, maxWidth: '1360px', margin: '0 auto', padding: '26px 36px 70px' }}>
        <Topbar />
        <NavRow />
        
        <div style={{ display: 'grid', gridTemplateColumns: 'repeat(4, 1fr)', gap: '18px', marginBottom: '20px' }}>
          <StatCard icon="🎓" label="Courses" value={24} stats={[{ label: 'Active courses', value: 3 }, { label: 'Upcoming courses', value: 1 }]} />
          <StatCard icon="📖" label="Number of lessons" value={220} stats={[{ label: 'Active lessons', value: 20 }, { label: 'Upcoming lessons', value: 4 }]} />
          <StatCard icon="👤" label="Number of enrollees" value={67} stats={[{ label: 'Passed enrollees', value: 60 }, { label: 'New enrollees', value: 7 }]} />
          <StatCard icon="🧑‍🎓" label="Number of students" value={17} stats={[{ label: 'Active students', value: 12 }, { label: 'New students', value: 5 }]} />
        </div>

        <div style={{ display: 'grid', gridTemplateColumns: '1.35fr 1fr', gap: '20px' }}>
          <RevenueChart />
          <WithdrawalList />
        </div>
      </div>
    </>
  );
}